# Patch test TRI3: 8 elementos, 9 nodos.
# Dominio [0,2] x [0,2]. Nodos de los bordes izq. y der. equiespaciados;
# el resto de los nodos fuera de posicion regular.
#
# Condiciones sugeridas (F = sigma*H*t/2, H = 1  ->  sigma_x exacta = 2F/(H t)):
#   nodo 1: ux = uy = 0        nodo 4: ux = 0 (rodillo)
#   fuerzas en x (cargas nodales consistentes):
#     nodo  3: 1 F
#     nodo  6: 2 F
#     nodo  7: -1 F
#     nodo  9: 1 F

# n_nodes n_elements dim
9 8 2

# node_number x y
1 0.0000 0.0000
2 1.2000 0.0000
3 2.0000 0.0000
4 0.0000 1.0000
5 1.0000 0.8000
6 2.0000 1.0000
7 0.0000 2.0000
8 0.9000 2.0000
9 2.0000 2.0000

# element_number element_type connectivity
1 TRI3  1 2 5
2 TRI3  1 5 4
3 TRI3  2 3 6
4 TRI3  2 6 5
5 TRI3  4 5 8
6 TRI3  4 8 7
7 TRI3  5 6 9
8 TRI3  5 9 8
