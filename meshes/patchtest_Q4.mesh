# Patch test QUAD4: 4 elementos, 9 nodos. 
# Dominio [0,2] x [0,2]. Nodos de los bordes izq. y der. equiespaciados
# y los nodos centrales fuera de posicion regular.
#
# Condiciones sugeridas (F = sigma*H*t/2, H = 1  ->  sigma_x exacta = 2F/(H t)):
#   nodo 1: ux = uy = 0        nodo 4: ux = 0 (rodillo)
#   fuerzas en x (cargas nodales consistentes):
#     nodo  3: 1 F
#     nodo  6: 2 F
#     nodo  7: -1 F
#     nodo  9: 1 F

# n_nodes | n_elements | dim | n_materials
9 4 2 1

# material_id | type | E | nu | rho
1 linear_elastic 2.1e+10 0.2 2400

# node_number | x | y
1 0.0000 0.0000
2 1.2000 0.0000
3 2.0000 0.0000
4 0.0000 1.0000
5 1.0000 0.8000
6 2.0000 1.0000
7 0.0000 2.0000
8 0.9000 2.0000
9 2.0000 2.0000

# element_number | element_type | material_id | connectivity
1 QUAD4  1 1 2 5 4
2 QUAD4  1 2 3 6 5
3 QUAD4  1 4 5 8 7
4 QUAD4  1 5 6 9 8
